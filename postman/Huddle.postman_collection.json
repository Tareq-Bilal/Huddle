        {
          "name": "Create Question",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Save the new question's UUID so \"Get Question By Id\" can use it",
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set(\"questionId\", pm.response.json().question.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"title\": \"How do I stream a large file in Node.js?\",\r\n    \"body\": \"I need to send a multi-gigabyte file without loading it into memory. What's the right approach with streams?\",\r\n    \"tags\": [\"Node.js\", \"Express\"]\r\n}",
