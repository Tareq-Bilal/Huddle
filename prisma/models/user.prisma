model User{
    id       Int      @id @default(autoincrement())
    name     String   @unique
    email    String   @unique
    passwordHash String
    reputation Int      @default(0)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    refreshTokens refreshToken[]
    questions Question[]
    answers   Answer[]

    @@map("users")
}